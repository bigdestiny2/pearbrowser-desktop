{
  "name": "pearbrowser-desktop",
  "productName": "PearBrowser",
  "version": "0.9.1",
  "description": "Local-first P2P browser, catalogue, and publishing platform with an embedded Pear OTA runtime.",
  "license": "Apache-2.0 AND MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "upgrade": "pear://tco5k7h38uoxatedp1wongdbhjxow1x7jiwm3t1i9cujbebhsbty",
  "scripts": {
    "preinstall": "node scripts/check-hiverelay-layout.mjs",
    "start": "electron electron/main.cjs",
    "run": "electron electron/main.cjs",
    "check:release-evidence": "node scripts/check-release-evidence.mjs",
    "check:origin-isolation-smoke-evidence": "node scripts/check-origin-isolation-smoke-evidence.mjs",
    "generate:release-evidence-handoff": "node scripts/generate-release-evidence-handoff.mjs",
    "generate:origin-isolation-smoke-evidence": "node scripts/generate-origin-isolation-smoke-evidence.mjs",
    "check:appling-release": "node scripts/check-appling-release.mjs",
    "check:native-signing": "node scripts/check-native-signing-credentials.mjs",
    "generate:native-signing-secret-plan": "node scripts/generate-native-signing-secret-plan.mjs",
    "check:native-release-assets": "node scripts/check-native-release-assets.mjs",
    "check:linux-appimage-metadata": "node scripts/check-linux-appimage-metadata.mjs",
    "resolve:native-release": "node scripts/resolve-native-release-asset.mjs",
    "verify:native-downloads": "node scripts/verify-native-downloads.mjs",
    "generate:native-install-snippet": "node scripts/generate-native-install-snippet.mjs",
    "generate:native-install-guide": "node scripts/generate-native-install-snippet.mjs --format guide",
    "generate:native-install-smoke-plan": "node scripts/generate-native-install-smoke-plan.mjs",
    "generate:origin-isolation-smoke-plan": "node scripts/generate-origin-isolation-smoke-plan.mjs",
    "generate:package-manager-manifests": "node scripts/generate-package-manager-manifests.mjs",
    "check:public-trust-readiness": "node scripts/check-public-trust-readiness.mjs",
    "check:wdk-cohort": "node scripts/check-wdk-cohort.mjs",
    "check:wdk-network": "node scripts/check-wdk-network.mjs",
    "generate:public-trust-operator-report": "node scripts/generate-public-trust-operator-report.mjs",
    "package:appling": "node scripts/collect-appling-artifacts.mjs",
    "package:macos-dmg": "node scripts/create-macos-dmg.mjs",
    "smoke:qvac:native": "node node_modules/bare/bin/bare qvac-smoke/index.mjs",
    "smoke:qvac:browser": "node node_modules/bare/bin/bare qvac-smoke/browser.mjs",
    "smoke:qvac:pear": "npm run smoke:qvac:native",
    "smoke:ask-browser:ui": "node qvac-smoke/ask-browser-ui.mjs",
    "smoke:ask-browser:native": "node node_modules/bare/bin/bare qvac-smoke/ask-browser.mjs",
    "smoke:runtime": "node scripts/runtime-rpc-smoke.mjs",
    "smoke:wdk:node": "node scripts/wdk-bare-smoke.mjs",
    "smoke:wdk:bare": "node node_modules/bare/bin/bare scripts/wdk-bare-smoke.mjs",
    "smoke:wdk:ceremony": "node node_modules/bare/bin/bare scripts/wdk-ceremony-smoke.mjs",
    "smoke:wdk:isolate": "node node_modules/bare/bin/bare scripts/wdk-isolate-smoke.mjs",
    "smoke:wdk:evm": "node node_modules/bare/bin/bare scripts/wdk-evm-worklet-smoke.mjs",
    "smoke:wdk:e2e": "node node_modules/bare/bin/bare scripts/wdk-e2e-testnet.mjs",
    "smoke:release-stories": "node scripts/release-rpc-story-smoke.mjs",
    "test": "node --test 'test/*.test.js'",
    "build:ui": "esbuild ui/main.js --bundle --format=esm --outfile=ui/dist/main.bundle.js --define:process.env.NODE_ENV='\"production\"' --minify",
    "prestart": "npm run -s build:ui"
  },
  "pear": {
    "name": "pearbrowser-desktop",
    "type": "desktop",
    "stage": {
      "ignore": [
        "/.git",
        "/.github",
        "/.gitignore",
        "/.DS_Store",
        "/.landing-seed.mjs",
        "**/.DS_Store",
        "/.claude",
        "/CHANGELOG.md",
        "/README.md",
        "/appling",
        "/docs",
        "/examples",
        "/previews",
        "/qvac-smoke",
        "/scripts",
        "/test",
        "/pearbrowser-storage"
      ],
      "entrypoints": [
        "/backend/index.js",
        "/backend/search-handler.js",
        "/backend/personal-index.cjs",
        "/backend/ai/qvac-runtime.mjs"
      ]
    },
    "links": [
      "http://127.0.0.1",
      "http://localhost",
      "ws://127.0.0.1",
      "ws://localhost",
      "https://",
      "http://"
    ],
    "gui": {
      "backgroundColor": "#f6f8f7",
      "height": 800,
      "width": 1280
    }
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@noble/secp256k1": "^3.1.0",
    "@qvac/bare-sdk": "0.14.1",
    "@qvac/llm-llamacpp": "0.36.3",
    "@tetherto/pear-wrk-wdk": "1.0.0-beta.11",
    "@tetherto/wdk": "1.0.0-beta.16",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.16",
    "autobase": "^7.27.3",
    "b4a": "^1.8.0",
    "bare-crypto": "^1.13.4",
    "bare-env": "3.0.0",
    "bare-events": "^2.0.0",
    "bare-fs": "^4.0.0",
    "bare-http1": "^4.5.8",
    "bare-https": "^2.1.3",
    "bare-path": "^3.0.0",
    "bare-process": "4.5.0",
    "bare-ws": "^2.1.0",
    "bip39-mnemonic": "^2.5.0",
    "blind-pairing": "^2.3.1",
    "corestore": "^7.9.2",
    "electron": "43.2.0",
    "framed-stream": "^1.0.0",
    "htm": "^3.1.1",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.28.1",
    "hypercore-crypto": "^3.5.0",
    "hyperdrive": "^13.3.2",
    "hyperswarm": "^4.17.0",
    "p2p-hiverelay": "latest",
    "p2p-hiverelay-client": "latest",
    "p2p-hiverelay-verifier": "latest",
    "pear-install": "1.2.2",
    "pear-runtime": "1.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "schema-sheets": "^3.1.1",
    "sodium-universal": "5.0.1"
  },
  "devDependencies": {
    "@tetherto/wdk-worklet-bundler": "1.0.0-beta.9",
    "bare": "1.30.3",
    "esbuild": "^0.28.2"
  },
  "overrides": {
    "@tetherto/wdk-wallet": "1.0.0-beta.16"
  }
}
